{
  "app": {
    "name": "편입/임시점용 조서 산출기",
    "version": "0.6.0"
  },
  "runtime": {
    "temp_root_dir": ".runtime_temp"
  },
  "csv": {
    "encodings": [
      "utf-8-sig",
      "cp949",
      "euc-kr",
      "utf-8"
    ],
    "output_encoding": "utf-8-sig"
  },
  "analysis": {
    "default_criterion_label": "도로기준",
    "round_digits": 2,
    "fallback_epsg": 5179,
    "warn_on_geographic_crs": true
  },
  "numbering": {
    "main_line_direction": "정방향",
    "main_line_direction_options": [
      "정방향",
      "역방향"
    ]
  },
  "cad": {
    "file_suffix": "CAD중첩",
    "crs_info_suffix": "CAD좌표계정보",
    "insunits": 6,
    "dxf_encoding": "cp949",
    "dwg_codepage": "ANSI_949",
    "parcel_clip_buffer_m": 20.0,
    "text_style": {
      "name": "MALGUN",
      "font_file": "malgun.ttf"
    },
    "layers": {
      "sheet": "YJ_SHEET",
      "parcel": "YJ_PARCEL",
      "lot_number": "YJ_LOTNO",
      "permanent": "YJ_PERM",
      "temporary": "YJ_TEMP",
      "register": "YJ_REG_NO",
      "leader": "YJ_REG_LEADER"
    },
    "colors": {
      "sheet": 8,
      "parcel": 9,
      "lot_number": 7,
      "permanent": 1,
      "temporary": 3,
      "register": 2,
      "leader": 8
    },
    "label": {
      "circle_radius_m": 2.0,
      "text_height_m": 1.2,
      "lot_text_height_m": 1.2,
      "offset_m": 6.0,
      "offset_scale": 0.6,
      "vertical_offset_ratio": 0.35,
      "alternate_sides": true,
      "minimum_spacing_m": 8.0,
      "geometry_clearance_m": 3.0
    }
  },
  "permanent_occupancy": {
    "default_width_m": 0.0,
    "use_pipe_diameter_as_minimum": true,
    "minimum_pipe_diameter_m": 0.0
  },
  "temporary_occupancy": {
    "soil_cover_options_m": [
      1.2,
      1.3,
      1.4,
      1.5,
      1.6,
      1.7,
      1.8,
      1.9,
      2.0
    ],
    "pavement_options": [
      "아스팔트",
      "콘크리트",
      "비포장"
    ],
    "excavation_slope_options": [
      "1:0.3",
      "1:0.5",
      "1:0.7",
      "1:1",
      "1:1.2",
      "1:1.5"
    ],
    "defaults": {
      "soil_cover_m": 1.2,
      "pavement_status": "아스팔트",
      "excavation_slope": "1:0.3"
    },
    "pipe_side_clearance_m": 0.4,
    "reference_depth_m": 0.9,
    "pavement_width_adjustment_m": {
      "아스팔트": 0.0,
      "콘크리트": 0.1,
      "비포장": -0.1
    },
    "round_up_to_0_1m": true,
    "minimum_pipe_diameter_m": 0.0
  },
  "common_occupancy_engine": {
    "default_feature_type": "pipe",
    "feature_rules": {
      "pipe": {
        "label": "관로",
        "geometry_family": "line",
        "permanent_model": {
          "type": "pipe_diameter_buffer",
          "config_ref": "permanent_occupancy"
        },
        "temporary_model": {
          "type": "trench_width_formula",
          "config_ref": "temporary_occupancy"
        },
        "metadata": {
          "category": "linear_network",
          "supports_segment_conditions": true
        }
      },
      "valve_chamber": {
        "label": "밸브실",
        "geometry_family": "polygon",
        "permanent_model": {
          "type": "footprint",
          "buffer_margin_m": 0.0
        },
        "temporary_model": {
          "type": "footprint_buffer",
          "buffer_margin_m": 1.5
        },
        "metadata": {
          "category": "structure",
          "structure_class": "valve_chamber"
        }
      },
      "manhole": {
        "label": "맨홀",
        "geometry_family": "point",
        "permanent_model": {
          "type": "point_buffer",
          "buffer_radius_m": 0.6
        },
        "temporary_model": {
          "type": "point_buffer",
          "buffer_radius_m": 1.5
        },
        "metadata": {
          "category": "structure",
          "structure_class": "manhole"
        }
      },
      "shoring_zone": {
        "label": "가시설 구간",
        "geometry_family": "line",
        "permanent_model": {
          "type": "none"
        },
        "temporary_model": {
          "type": "segment_condition_modifier",
          "modifier_key": "shoring"
        },
        "metadata": {
          "category": "construction_condition",
          "affects_temporary_only": true
        }
      }
    }
  },
